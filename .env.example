# Zoho CRM — required. lib/zoho.ts throws without all three.
ZOHO_CLIENT_ID="your_client_id"
ZOHO_CLIENT_SECRET="your_client_secret"
ZOHO_REFRESH_TOKEN="your_refresh_token"

# Sentry — optional.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_NEXT_CURRENT_ENV="development"

# Optional. Backs the Seller tab's "Next Actionables" free-text box (lib/actionables.ts) so
# what one person types is saved and shown to everyone. Without these, it still works locally
# but falls back to a per-process in-memory value — not shared across viewers or deployments.
# A Vercel KV / Upstash Redis database's REST credentials; Vercel KV also names these
# KV_REST_API_URL / KV_REST_API_TOKEN, which lib/actionables.ts reads as a fallback.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Live buyer AND seller spend, read straight from the growth team's "Spends" Google Sheet —
# added 2026-09-28, restructured into separate Buyer/Seller/Mapping tabs on 2026-09-29. Shared
# "anyone with the link can view", so this needs no credential: SPEND_SHEET_ID is the
# spreadsheet's id out of its URL, *_SPEND_SHEET_GID the gid of each side's tab (from the URL
# when that tab is selected — they are NOT "0", the sheet has no tab at gid 0 any more since the
# restructure). Buyer takes priority over the ledger and its snapshot whenever SPEND_SHEET_ID is
# set — see lib/buyer/spend/source.ts. Seller only switches to live when BOTH SPEND_SHEET_ID
# and SELLER_SPEND_SHEET_GID are set — see lib/seller/spend/source.ts — so buyer can go live
# without seller being forced to follow before its tab exists.
SPEND_SHEET_ID=""
BUYER_SPEND_SHEET_GID=""
SELLER_SPEND_SHEET_GID=""

# The growth activity ledger (apps/growth in the monorepo) — an older live source of buyer
# spend for the Buyer tab, superseded by SPEND_SHEET_ID above but left in place as a fallback.
# When BOTH are set (and SPEND_SHEET_ID is not), lib/buyer/spend/source.ts reads day × source ×
# micromarket from the ledger and the committed spend-jas26.json snapshot is not consulted.
# When either is missing, the snapshot is used, which is also the only source of pre-ledger
# history.
#
# The read does NOT fall back to the snapshot on an error once configured: serving stale
# numbers from a committed file is exactly the divergence the ledger exists to remove, so a
# failed read surfaces as a gap in the spend block instead.
#
# The key is growth's API_KEY, sent as x-api-key — the same key its scheduler uses. There is a
# narrower EXTERNAL_API_KEY gate in the shared middleware, but it is not worth a second secret to
# rotate for one read-only GET.
GROWTH_LEDGER_BASE_URL="http://localhost:4003"
GROWTH_LEDGER_API_KEY=""

# The kill switch. Leave it unset: the ledger is on wherever the two vars above are set, and this
# exists to turn it back off in a hurry — set it to false and the dashboard serves the committed
# snapshot again, with no code deploy and without pulling the key out.
#
# Only false, 0, off and no turn it off. Anything else leaves the ledger on, because a typo in an
# env var must not quietly change where the spend numbers come from.
# GROWTH_LEDGER_ENABLED="false"

# Live Meta (Facebook/Instagram) ad spend, pulled directly from the Graph API — added
# 2026-09-28, layered ON TOP of whichever source above is active. Overlays just the 'meta'
# rawSource rows with a fresh pull; every other source (3P, Offline, etc.) is untouched.
# Channel-level only — does NOT split by micromarket, since real campaign names aren't a
# reliable signal for that (see lib/shared/metaAds.ts's doc comment). Leave both unset to skip
# this entirely and keep reading Meta from the ledger/snapshot like every other source.
#
# META_ACCESS_TOKEN needs `ads_read` on every account below — generate it as a Meta Business
# Manager System User token (Business Settings -> Users -> System Users -> Generate New Token),
# not a personal user token, so it doesn't expire when someone's own login session does.
META_ACCESS_TOKEN=""

# The 7 ad accounts confirmed live 2026-09-28 as Truva's own (business id 394939327028996) —
# NOT "Truva - Loans" (a different product line) and NOT any account belonging to a different
# business sharing the same ad-tech setup (RubyX Estate, Beyond Realty, Sakura). The main
# "Truva" account mixes Buyer and Seller campaigns together, so lib/buyer/spend/meta.ts and
# lib/seller/spend/meta.ts each classify by campaign NAME (containing "buyer" or "seller"),
# not by which account a campaign happens to live in.
META_AD_ACCOUNT_IDS="814274174180507,1576988430025840,27122828643996823,1303539187752290,1165248159004918,1481543209781210,1251323773233653"
#   814274174180507   Truva (main; mixed Buyer + Seller campaigns)
#   1576988430025840  Truva - Amsterdam
#   27122828643996823 Truva - Bandra
#   1303539187752290  Truva_Netcore (Read-Only)
#   1165248159004918  Truva Netcore CP (Read-Only)
#   1481543209781210  Truva 2 Netcore (Read-Only)
#   1251323773233653  Truva_Seller

# Kill switch, same convention as GROWTH_LEDGER_ENABLED: only false/0/off/no turn it off.
# META_DIRECT_ENABLED="false"
