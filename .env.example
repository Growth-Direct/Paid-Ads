# Zoho CRM — NOT needed by the dashboard. Buyer and seller read every Zoho record from growth's
# copy of the Zoho sync mirror (lib/crm.ts, through the GROWTH_LEDGER_* pair below), so the
# deployment holds no Zoho credential. Only the local scripts/ still call Zoho through
# lib/zoho.ts, which throws without all three.
ZOHO_CLIENT_ID="your_client_id"
ZOHO_CLIENT_SECRET="your_client_secret"
ZOHO_REFRESH_TOKEN="your_refresh_token"

# Auth0 — @auth0/nextjs-auth0 v4 names. v3 used AUTH0_BASE_URL and
# AUTH0_ISSUER_BASE_URL; the installed SDK does not read either of those.
# AUTH0_DOMAIN is the bare tenant domain, no protocol. APP_BASE_URL is a full URL.
AUTH0_SECRET="openssl rand -hex 32"
AUTH0_DOMAIN="your-tenant.auth0.com"
APP_BASE_URL="http://localhost:5002"
AUTH0_CLIENT_ID="your_client_id"
AUTH0_CLIENT_SECRET="your_client_secret"

# Auth routes. The prefix must match where the auth handler actually lives,
# otherwise the middleware gates the login route itself and sign-in breaks.
NEXT_PUBLIC_AUTH0_PREFIX="/api/unprotected"
NEXT_PUBLIC_AUTH0_LOGIN="/api/unprotected/auth/login"
NEXT_PUBLIC_AUTH0_LOGOUT="/api/unprotected/auth/logout"

# Session revalidation against Google Workspace — REQUIRED in any deployed
# environment. Every ~30 min the middleware re-checks that a @truva.in user is
# still an active employee (SessionRevalidator). It FAILS CLOSED: if this is
# missing or unparseable, every @truva.in session is invalidated and the whole
# team gets 401s on /api/buyer and /api/seller. It was absent from Vercel and
# from this file until 2026-09-07, which is exactly how that outage happened.
#
# Value is the service-account JSON, pasted RAW — no surrounding quotes. Vercel
# stores whatever you paste verbatim, and a wrapping ' or " makes JSON.parse
# fail with "contains invalid JSON". The value must start with { and end with }.
# The account needs domain-wide delegation for the read-only scope
# https://www.googleapis.com/auth/admin.directory.user.readonly
GOOGLE_SA_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
# Admin the service account impersonates when reading the directory.
# Defaults to ankit@truva.in when unset.
GOOGLE_SA_IMPERSONATE_USER="admin@truva.in"
# Revalidation frequency in minutes. Defaults to 30 when unset.
SESSION_REVALIDATION_INTERVAL_MINS="30"

# Sentry — optional.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_NEXT_CURRENT_ENV="development"

# Local only. Skips the Auth0 gate when NODE_ENV=development. Never set in Vercel.
LOCAL_PREVIEW_SKIP_AUTH="true"

# Optional. Backs the Seller tab's "Next Actionables" free-text box (lib/actionables.ts) so
# what one person types is saved and shown to everyone. Without these, it still works locally
# but falls back to a per-process in-memory value — not shared across viewers or deployments.
# A Vercel KV / Upstash Redis database's REST credentials; Vercel KV also names these
# KV_REST_API_URL / KV_REST_API_TOKEN, which lib/actionables.ts reads as a fallback.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# The growth activity ledger (apps/growth in the monorepo) — the live source of buyer spend
# for the Buyer tab. When BOTH are set, lib/buyer/spend/source.ts reads day × source ×
# micromarket from the ledger and the committed spend-jas26.json snapshot is not consulted.
# When either is missing, the snapshot is used, which is also the only source of pre-ledger
# history.
#
# The read does NOT fall back to the snapshot on an error once configured: serving stale
# numbers from a committed file is exactly the divergence the ledger exists to remove, so a
# failed read surfaces as a gap in the spend block instead.
#
# The key is growth's API_KEY, sent as x-api-key — the same key its scheduler uses. There is a
# narrower EXTERNAL_API_KEY gate in the shared middleware, but it is not worth a second secret to
# rotate for one read-only GET.
#
# This pair is also where ALL buyer and seller data comes from: lib/crm.ts reads every Zoho record
# from growth's POST /api/crm-mirror/records. Without it both tabs fail to load. The kill switch
# below turns off the spend ledger only, never those reads.
GROWTH_LEDGER_BASE_URL="http://localhost:4003"
GROWTH_LEDGER_API_KEY=""

# The kill switch. Leave it unset: the ledger is on wherever the two vars above are set, and this
# exists to turn it back off in a hurry — set it to false and the dashboard serves the committed
# snapshot again, with no code deploy and without pulling the key out.
#
# Only false, 0, off and no turn it off. Anything else leaves the ledger on, because a typo in an
# env var must not quietly change where the spend numbers come from.
# GROWTH_LEDGER_ENABLED="false"

# ─────────────────────────────────────────────────────────────────────────────────────────────
# Data-procurement dashboard — homeowner-data procurement % per society, against Truva-Qualified
# societies.
#
# The ratio itself is NOT computed here. growth (apps/growth in the monorepo) owns it and serves
# GET /api/procurement/societies, because the two sources it needs are private: the Zoho sync
# mirror and truiq's MySQL both sit inside the VPC, and Metabase's load balancer is IP
# allowlisted. Vercel has no static egress IP on any plan below Enterprise, so this dashboard
# cannot reach any of them — see known-traps.md trap 42. growth runs on App Runner with a VPC
# connector and can.
#
# So this repo does two things: read the ratio from growth, and add priority from Airtable.
#
# Nothing new to set: it reads the GROWTH_LEDGER_* pair above, because procurement is the same
# growth service reached through the same x-api-key gate. One variable decides where both the
# spend ledger and procurement go — point it at http://localhost:4003 to run against a local
# growth.
#
# growth's middleware does have a narrower EXTERNAL_API_KEY gate for routes under /api/external/,
# but that variable is not configured on the service and standing it up would mean a second secret
# on both sides for one more read-only GET by a consumer that already holds this one. So the
# procurement route sits at /api/procurement/, not /api/external/, rather than advertising a gate
# it does not use.

# Airtable — priority (P0/P1/P2) per unit, from the Growth – Marketing base.
#
# Priority lives HERE rather than in growth, on purpose. It is a label used for grouping, not a
# term in the ratio, and Airtable's API is public so Vercel can reach it directly. Keeping it on
# this side means an Airtable outage cannot touch the procurement numbers at all — the societies
# still render, just without priority grouping.
#
# AIRTABLE_API_KEY is a personal access token (pat...), scoped read-only to this one base, with
# the data.records:read and schema.bases:read scopes.
# AIRTABLE_TQ_TABLE is the table name as Airtable shows it, or its tbl... id — either works.
AIRTABLE_API_KEY=""
AIRTABLE_BASE_ID=""
AIRTABLE_TQ_TABLE="TQ Unit wise"

# The two column names in that table, if they are ever renamed. Defaults shown.
# AIRTABLE_TQ_SOCIETY_FIELD="Society"
# AIRTABLE_TQ_PRIORITY_FIELD="Priority"
